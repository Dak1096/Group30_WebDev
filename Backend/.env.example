# Copy this file to .env and fill in your own values
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=sms_db
JWT_SECRET=replace_with_a_long_random_string
PORT=3000

# Shortest word the fulltext search will accept.
# Must match innodb_ft_min_token_size in my.ini, see README_UPGRADE.md
FT_MIN_TOKEN_SIZE=2
